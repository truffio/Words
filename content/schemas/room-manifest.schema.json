{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/truffio/Words/content/schemas/room-manifest.schema.json",
  "title": "Room manifest",
  "description": "The vocabulary used in one room and its per-object settings.",
  "type": "object",
  "required": ["id", "title", "objects"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Room ID; must match the room's folder name.",
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "title": {
      "description": "Display name, e.g. \"Kitchen\".",
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Lexicon ID of the object.",
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)*$"
          },
          "difficulty": {
            "description": "1 (easiest) to 3.",
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    }
  }
}
